# Settings for the ApertureDB Docker Compose package; see docker-compose.yml.
# The Web UI and REST API are at https://localhost:8443/.
HTTP_PORT=${HTTP_PORT:-8087}
HTTPS_PORT=${HTTPS_PORT:-8443}
# The connection limits workflow tests have always run with.
LNZ_ADB_MAX_CONCURRENCY=${LNZ_ADB_MAX_CONCURRENCY:-48}
ADB_MAX_SIMULTANEOUS_CLIENTS=${ADB_MAX_SIMULTANEOUS_CLIENTS:-500}
