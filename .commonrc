# if length of command line arguments is 0, then print usage
CI_RUN=${CI_RUN:-0}
RUNNER_NAME="${RUNNER_NAME:-runner}"
# remove spaces from RUNNER_NAME
RUNNER_NAME="${RUNNER_NAME// /}"
# convert to lowercase (a restriction of docker compose)
RUNNER_NAME="${RUNNER_NAME,,}"

CLEANUP_ON_EXIT=${CLEANUP_ON_EXIT:-1}

export BIN_DIR=$PWD
TEST_LOG=$BIN_DIR/test.log
export ROOT_DIR=$BIN_DIR/../..
COMPOSE_PROJECT_NAME="$(basename $BIN_DIR)"
SANDBOXED_COMPOSE_PROJECT_NAME="${RUNNER_NAME}-${COMPOSE_PROJECT_NAME}"


COMPOSE_MAIN="$ROOT_DIR/docker-compose.yml"
COMPOSE_SCRIPT="$ROOT_DIR/compose.sh"


COMMAND="$COMPOSE_SCRIPT -p $SANDBOXED_COMPOSE_PROJECT_NAME -f $COMPOSE_MAIN"
# Check if test directory exists
if [ -d "$BIN_DIR/test" ]; then
  COMPOSE_TEST="$BIN_DIR/test/docker-compose.yml"
  COMMAND="$COMMAND -f $COMPOSE_TEST"
fi

echo "COMMAND: $COMMAND"

export DB_HOST="lenz"
export DB_PORT="55551"
export DB_PASS="admin"

cleanup() {
  if [ -n "${TEST_METADATA_DIR:-}" ]; then
    local metadata_log
    metadata_log=$(mktemp)
    # Snapshot synchronously: the background follower may not have started yet.
    # This private temporary log is never an uploaded artifact.
    $COMMAND logs > "$metadata_log" 2>&1 || true
    bash "$ROOT_DIR/tests/capture_test_state.sh" "$SANDBOXED_COMPOSE_PROJECT_NAME" \
      "${TEST_PHASE:-setup}" "${ret:-0}" "$metadata_log" "$TEST_METADATA_DIR/test-state.json" || \
      echo "Test state metadata collection failed."
    rm -f "$metadata_log"
  fi
  $COMMAND logs | tee -a $TEST_LOG
  $COMMAND down --remove-orphans || true
}

final_banner() {
  rc=$1
  if [ $rc -eq 0 ]; then
    printf "\n\033[1;32m✅  SUCCESS\033[0m: %s\n" "$COMPOSE_PROJECT_NAME"
  else
    printf "\n\033[1;31m❌  FAILURE\033[0m: %s (exit code %d)\n" \
      "$COMPOSE_PROJECT_NAME" "$rc"
  fi
}

trap 'echo "ERROR on line $LINENO: $BASH_COMMAND"' ERR
trap 'ret=$?; if [ $CLEANUP_ON_EXIT -eq 1 ]; then cleanup; fi; final_banner $ret ; sleep 10; exit $ret' EXIT

build_base() (
  set -e
  SDK_WHEEL_DIR=$(mktemp -d)
  export SDK_WHEEL_DIR
  trap 'rm -rf "$SDK_WHEEL_DIR"' EXIT
  # CI passes SDK_REF and WORKFLOWS_REF, the wheel digests it resolved for the
  # run; local builds use the current release.
  oras pull "${SDK_REF:-registry-1.docker.io/aperturedata/aperturedb-python:dev}" --output "$SDK_WHEEL_DIR"
  oras pull "${WORKFLOWS_REF:-registry-1.docker.io/aperturedata/aperturedb-workflows:dev}" --output "$SDK_WHEEL_DIR"
  $COMMAND build base
)

run_pytest() {
  BUILD_WORKFLOW=${BUILD_WORKFLOW:-1}
  # ---- run tests ----
  echo ">>> Running $COMPOSE_PROJECT_NAME tests (project=$COMPOSE_PROJECT_NAME)"


  # Should the test script be building this workflow?
  if [ $CI_RUN -eq 0 ]; then
    TEST_PHASE=base_build
    build_base
  fi

  if [ $BUILD_WORKFLOW -eq 1 ]; then
    TEST_PHASE=application_build
    $COMMAND build test-base $COMPOSE_PROJECT_NAME
  else
    TEST_PHASE=test_image_build
    $COMMAND build test-base
  fi

  # This log file is useful for debugging test failures
  echo "Writing logs to $TEST_LOG"
  (
    sleep 5
    $COMMAND logs -f > $TEST_LOG
  ) &
  LOG_PID=$!

  TEST_PHASE=integration
  $COMMAND up --no-build --exit-code-from tests tests

  # Wait for logs to finish
  kill $LOG_PID || true
}
